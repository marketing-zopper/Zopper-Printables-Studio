# ---- Browser (public; safe to expose) -------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Keep the legacy email+password sign-in link on the login page while Google
# sign-in is being rolled out. Set to "false" to remove it from the UI.
VITE_ENABLE_PASSWORD_LOGIN=true

# ---- Server only: /api functions (set in Vercel -> Settings -> Environment
# Variables; NEVER prefix with VITE_, never commit real values) -------------
# Defaults to VITE_SUPABASE_URL when unset.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Central Master App employee store. Printables Studio only ever reads it.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
